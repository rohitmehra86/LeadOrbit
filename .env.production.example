LEADORBIT_ENV=production
AUTH_MODE=supabase
NODE_ENV=production
SESSION_SECRET= # REQUIRED — never use defaults; openssl rand -base64 48
NEXT_PUBLIC_APP_URL=https://app.example.com
CSRF_STRICT=1
CSRF_ALLOWED_ORIGINS=https://app.example.com
RATE_LIMIT_PER_WINDOW=60
RATE_LIMIT_WINDOW_MS=60000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
PGVECTOR_ENABLED=true

# Production worker must NOT share Vercel serverless — deploy Fly/Railway
LEADORBIT_SQLITE_PATH=
# Prefer Postgres-backed queue before multi-region; SQLite only for single-node
WORKER_HEALTH_PORT=43128
WORKER_POLL_MS=250
QUEUE_DEAD_LETTER_ALERT=5
QUEUE_PENDING_ALERT=200

SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=leadorbit-production
ALERT_WEBHOOK_URL=

# Live billing keys — rotate webhook secrets after leak
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

LLM_API_KEY=
OPENAI_API_KEY=
