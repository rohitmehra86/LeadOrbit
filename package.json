{
  "name": "leadorbit",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @leadorbit/web dev",
    "dev:worker": "pnpm --filter @leadorbit/worker dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && node --import tsx --test tests/contract/**/*.test.ts tests/unit/**/*.test.ts",
    "test:integration": "pnpm --filter @leadorbit/db exec node --import tsx --test src/m11-integration.test.ts",
    "test:security": "node --import tsx --test tests/security/**/*.test.ts",
    "test:perf": "LEADORBIT_BASE_URL=${LEADORBIT_BASE_URL:-http://127.0.0.1:43127} node --import tsx --test tests/perf/**/*.test.ts",
    "test:e2e": "playwright test",
    "test:m11": "pnpm test && pnpm test:integration && pnpm test:security && pnpm test:perf",
    "audit:deps": "pnpm audit --audit-level=high",
    "migrate:status": "bash scripts/migrate.sh status",
    "migrate:apply": "bash scripts/migrate.sh apply",
    "deploy:check": "bash scripts/deploy-check.sh",
    "format": "prettier --write ."
  },
  "dependencies": {
    "next": "15.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@types/node": "^20",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "turbo": "^2.5.8",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp", "unrs-resolver"]
  }
}
