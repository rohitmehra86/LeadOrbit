LEADORBIT_ENV=staging
AUTH_MODE=supabase
SESSION_SECRET= # REQUIRED — openssl rand -base64 48
NEXT_PUBLIC_APP_URL=https://staging.example.com
CSRF_STRICT=1
CSRF_ALLOWED_ORIGINS=https://staging.example.com
RATE_LIMIT_PER_WINDOW=120

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Worker: managed SQLite/Postgres job store path or connection
LEADORBIT_SQLITE_PATH=
WORKER_HEALTH_PORT=43128
WORKER_POLL_MS=500

# Observability — staging should have at least error tracking
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
ALERT_WEBHOOK_URL=

# Billing: use Stripe/Razorpay test keys only
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
