# Copy to apps/web/.env.local and apps/worker/.env as needed.
# Never commit real secrets.

# --- Auth mode ---
# local (default when Supabase unset) | supabase
AUTH_MODE=local
DEV_SESSION_SECRET=change-me-in-any-shared-environment

# --- Supabase (required for production AUTH_MODE=supabase) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43127
# Shared by web + worker (default: <repo>/.data/leadorbit.sqlite)
LEADORBIT_SQLITE_PATH=
DEV_CAPTURE_TOKEN=dev-capture
WORKER_POLL_MS=500


# --- Worker / queue (Milestone 3+) ---
QUEUE_DRIVER=memory

# --- Optional providers (Milestone 4+) ---
# LLM_API_KEY=
# OPENAI_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_API_KEY=
# PGVECTOR_ENABLED=false
# DATABASE_URL=
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# MICROSOFT_CALENDAR_CLIENT_ID=
# MICROSOFT_CALENDAR_CLIENT_SECRET=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# VONAGE_API_KEY=
# VONAGE_API_SECRET=
# CUSTOM_TELEPHONY_WEBHOOK_URL=
# META_ADS_ACCESS_TOKEN=
# GOOGLE_ADS_DEVELOPER_TOKEN=
# WHATSAPP_TOKEN=
# SMTP_URL=
# RESEND_API_KEY=
# TWILIO_AUTH_TOKEN=
# META_MESSAGING_TOKEN=
# STRIPE_SECRET_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# WHATSAPP_TOKEN=
# META_APP_ID=
