# Copy to apps/web/.env.local and apps/worker/.env as needed.
# Never commit real secrets.

# --- Auth mode ---
# local (default when Supabase unset) | supabase
AUTH_MODE=local
DEV_SESSION_SECRET=change-me-in-any-shared-environment

# --- Supabase (required for production AUTH_MODE=supabase) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43127
LEADORBIT_SQLITE_PATH=
DEV_CAPTURE_TOKEN=dev-capture


# --- Worker / queue (Milestone 3+) ---
QUEUE_DRIVER=memory

# --- Optional providers (later milestones) ---
# OPENAI_API_KEY=
# STRIPE_SECRET_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# WHATSAPP_TOKEN=
# META_APP_ID=
# GOOGLE_ADS_DEVELOPER_TOKEN=
