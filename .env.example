# LeadOrbit — master env template
# Prefer env-specific files: .env.development.example / .env.staging.example / .env.production.example
# Never commit real secrets.

LEADORBIT_ENV=development
AUTH_MODE=local
SESSION_SECRET=change-me-use-long-random-in-shared-envs
DEV_SESSION_SECRET=

NEXT_PUBLIC_APP_URL=http://127.0.0.1:43127
LEADORBIT_SQLITE_PATH=
WORKER_POLL_MS=500
WORKER_HEALTH_PORT=43128
QUEUE_DRIVER=sqlite
DEV_CAPTURE_TOKEN=dev-capture

CSRF_ALLOWED_ORIGINS=
CSRF_STRICT=
CSRF_ALLOW_MISSING=
RATE_LIMIT_PER_WINDOW=120
RATE_LIMIT_WINDOW_MS=60000
QUEUE_DEAD_LETTER_ALERT=10
QUEUE_PENDING_ALERT=500

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
PGVECTOR_ENABLED=false

SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=leadorbit
ALERT_WEBHOOK_URL=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_ANNUAL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
BILLING_SUCCESS_URL=
BILLING_CANCEL_URL=

LLM_API_KEY=
OPENAI_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
EMBEDDING_API_KEY=

# Wave 4 providers — leave empty for pending_configuration (never fake live success)
# Connect Meta (Facebook Login for Business) — server-only; never NEXT_PUBLIC_*
META_ADS_APP_ID=
META_ADS_APP_SECRET=
# User access token Login for Business configuration id
META_ADS_LOGIN_CONFIG_ID=
META_ADS_OAUTH_REDIRECT_URI=
META_ADS_TOKEN_ENCRYPTION_KEY=
# Platform demo only — leave unset so customers must Connect Meta
META_ADS_ALLOW_ENV_FALLBACK=
META_ADS_ACCESS_TOKEN=
META_ADS_AD_ACCOUNT_ID=
META_ADS_PAGE_ID=
META_ADS_PIXEL_ID=
META_ADS_LEAD_GEN_FORM_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
MESSAGING_WEBHOOK_SECRET=
SMTP_URL=
RESEND_API_KEY=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
META_MESSAGING_TOKEN=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
MICROSOFT_CALENDAR_CLIENT_ID=
