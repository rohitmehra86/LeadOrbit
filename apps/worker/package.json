{
  "name": "@leadorbit/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "echo 'worker lint deferred to shared eslint config'",

    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@leadorbit/api-contracts": "workspace:*",
    "@leadorbit/domain": "workspace:*",
    "@leadorbit/db": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
}
